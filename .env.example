# Database
DATABASE_URL="postgresql://user:password@localhost:5432/my-app"

# Auth.js
AUTH_SECRET="generate-a-secret-here"
AUTH_TRUST_HOST="true"
AUTH_POSTMARK_API_TOKEN="your-postmark-server-token"
AUTH_POSTMARK_SENDER="App Name <app@yourdomain.com>"

# S3 Storage
S3_ENDPOINT_URL="https://s3.amazonaws.com"
S3_REGION="eu-central-1"
S3_ACCESS_KEY_ID="your-access-key"
S3_ACCESS_KEY_SECRET="your-secret-key"
S3_BUCKET_NAME="your-bucket"

# Postmark (transactional emails)
POSTMARK_API_TOKEN="your-postmark-server-token"
POSTMARK_SENDER="App Name <info@yourdomain.com>"

# App
TZ="Europe/Berlin"
ORIGIN="http://localhost:5173"
BODY_SIZE_LIMIT="10M"
